#!/bin/bash
# Keep Vencord's active theme in step with the Omarchy theme.
# Vencord only reads ~/.config/Vencord/themes/*.theme.css, and watches that
# directory, so copying the file (rather than linking the theme's) makes a
# theme switch restyle a running Discord without a restart.
set -u

theme="$HOME/.local/state/omarchy/current/theme"
themes_dir="$HOME/.config/Vencord/themes"
target="$themes_dir/omarchy.theme.css"

mkdir -p "$themes_dir"

if [ -f "$theme/vencord.theme.css" ]; then
  cp "$theme/vencord.theme.css" "$target"
else
  # This theme ships no Vencord colours; do not leave the previous theme's behind.
  rm -f "$target"
fi
