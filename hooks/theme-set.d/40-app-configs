#!/bin/bash
# Point apps that read their own config at the active theme's rendered files.
# Everything Omarchy generates itself (terminals, neovim, helix, vscode, shell,
# gtk) is not touched here.
set -u

theme="$HOME/.local/state/omarchy/current/theme"

link_if_present() {
  local name="$1" target="$2"
  if [ -f "$theme/$name" ]; then
    mkdir -p "$(dirname "$target")"
    # only ever replace our own link or a plain file we can back up once
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      ln -sfn "$theme/$name" "$target"
    fi
  elif [ -L "$target" ] && [ ! -e "$target" ]; then
    rm -f "$target"   # the previous theme's file is gone: do not leave a dangling link
  fi
}

link_if_present lazygit.yml  "$HOME/.config/lazygit/config.yml"
link_if_present starship.toml "$HOME/.config/starship.toml"

if [ -f "$theme/fzf.sh" ]; then
  mkdir -p "$HOME/.config/fzf"
  cp "$theme/fzf.sh" "$HOME/.config/fzf/omarchy-theme.sh"
fi
