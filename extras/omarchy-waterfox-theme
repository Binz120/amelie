#!/usr/bin/env python3
"""Paint Waterfox (and any Firefox-derived browser) with the active Omarchy theme.

Renders userChrome.css and userContent.css from the staged theme's colors.toml
into every Waterfox profile that has a prefs.js, and makes sure the profile is
allowed to load chrome stylesheets. Colour only: no layout, no hidden chrome.

Usage:
    omarchy-waterfox-theme            # use the active Omarchy theme
    omarchy-waterfox-theme <slug>     # use ~/.config/omarchy/themes/<slug>
    omarchy-waterfox-theme --dry-run
"""
from __future__ import annotations

import os
import sys
import tomllib
from pathlib import Path

PROFILES_DIR = Path(os.environ.get("WATERFOX_PROFILES", Path.home() / ".waterfox"))
STATE_THEME = Path.home() / ".local/state/omarchy/current/theme"
USER_THEMES = Path.home() / ".config/omarchy/themes"

REQUIRED_PREFS = {
    "toolkit.legacyUserProfileCustomizations.stylesheets": "true",
    "browser.theme.content-theme": "0",
    "browser.theme.toolbar-theme": "0",
    "ui.systemUsesDarkTheme": "1",
}


def load_colors(slug: str | None) -> tuple[dict, str]:
    if slug:
        path = USER_THEMES / slug / "colors.toml"
        if not path.is_file():
            sys.exit(f"no theme at {path}")
    else:
        path = STATE_THEME / "colors.toml"
        if not path.is_file():
            path = USER_THEMES / "deux-moulins" / "colors.toml"
    with path.open("rb") as fh:
        colors = tomllib.load(fh)
    return colors, path.parent.name


def palette(c: dict) -> dict[str, str]:
    def g(*names: str) -> str:
        for n in names:
            if n in c:
                return c[n]
        return "#000000"

    return {
        "bg": g("background"),
        "bg_deep": g("dark_background", "darker_background", "background"),
        "bg_deeper": g("darker_background", "dark_background", "background"),
        "bg_light": g("lighter_background", "background"),
        "fg": g("foreground"),
        "fg_dim": g("muted", "dark_foreground", "foreground"),
        "fg_bright": g("bright_foreground", "light_foreground", "foreground"),
        "accent": g("accent"),
        "selection": g("selection", "accent"),
        "selection_fg": g("selection_foreground", "foreground"),
        "attention": g("red", "accent"),
        "green": g("green", "accent"),
        "border": g("accent"),
    }


def rgba(hexcolor: str, alpha: float) -> str:
    h = hexcolor.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r}, {g}, {b}, {alpha:.2f})"


