"""


def write_prefs(profile: Path, dry: bool) -> list[str]:
    user_js = profile / "user.js"
    existing = user_js.read_text() if user_js.is_file() else ""
    added = []
    for key, value in REQUIRED_PREFS.items():
        if f'user_pref("{key}"' in existing:
            continue
        added.append(f'user_pref("{key}", {value});')
    if added and not dry:
        with user_js.open("a") as fh:
            fh.write("\n// Omarchy browser theming\n" + "\n".join(added) + "\n")
    return added


def main(argv: list[str]) -> int:
    dry = "--dry-run" in argv
    slug = next((a for a in argv[1:] if not a.startswith("-")), None)
    colors, theme_slug = load_colors(slug)
    p = palette(colors)
    p["slug"] = theme_slug
    p["hover"] = rgba(p["fg"], 0.10)
    p["line"] = rgba(p["accent"], 0.35)
    # the tab strip sits a step below the toolbar so the selected tab reads as
    # raised; idle labels are lifted off the strip so they are not washed out
    p["tabstrip"] = p["bg_deeper"]
    p["tab_selected"] = p["selection"]
    p["tab_idle"] = rgba(p["fg"], 0.80)

    if not PROFILES_DIR.is_dir():
        sys.exit(f"no Waterfox profiles at {PROFILES_DIR}")

    profiles = [d for d in sorted(PROFILES_DIR.iterdir()) if (d / "prefs.js").is_file()]
    if not profiles:
        sys.exit("no Waterfox profile with a prefs.js found")

    for profile in profiles:
        chrome = profile / "chrome"
        if not dry:
            chrome.mkdir(exist_ok=True)
            (chrome / "userChrome.css").write_text(CHROME_CSS.format(**p))
            (chrome / "userContent.css").write_text(CONTENT_CSS.format(**p))
        added = write_prefs(profile, dry)
        note = f" (+{len(added)} prefs)" if added else ""
        print(f"{'would paint' if dry else 'painted'} {profile.name} with {theme_slug}{note}")

    restarted = [p for p in profiles if (p / ".parentlock").exists()]
    if restarted:
        print("Waterfox is running — quit and reopen it for the chrome to load.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
